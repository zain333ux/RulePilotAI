# ==============================================================================
# RulePilot AI - Environment Variable Configuration Template
# Copy this file to .env.local for local development. Never commit .env.local!
# ==============================================================================

# --- SERVER-ONLY (API routes / Server Actions only — NEVER NEXT_PUBLIC_) ------
# Google Gemini API Key
GEMINI_API_KEY=

# Supabase Service Role Key (bypasses RLS — never ship to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Make / Zapier Webhook URL for action notifications (optional)
MAKE_WEBHOOK_URL=

# --- PUBLIC (safe for client components) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
