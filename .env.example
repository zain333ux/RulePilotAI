# RulePilot AI environment variables
# Copy this file to .env.local and fill in local values.

# Server-only. Never expose these through NEXT_PUBLIC_ variables.
GEMINI_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MAKE_WEBHOOK_URL=

# Browser-safe Supabase configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional live repository smoke test target. Must reference an existing document.
RULEPILOT_SMOKE_DOCUMENT_ID=
